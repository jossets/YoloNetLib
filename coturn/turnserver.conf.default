# Your server fqdn
realm=coturn.server.my
fingerprint


listening-port=3478

min-port=50000
max-port=51000

# Your server shared secret with clients
use-auth-secret
static-auth-secret=COTURN_SECRET

#lt-cred-mech
#user=user01:user01Password
#user=user02:user02Password

#
# Sécurité
#

# Pas de TLS/DTLS configuré (pas de certificat) : fermer ces listeners
no-tls
no-dtls
# Console d'admin telnet : désactivée par défaut, ne pas ajouter "cli"
# Le jeu n'utilise que des DataChannels UDP : pas d'allocation de relais TCP (RFC 6062)
no-tcp-relay
no-multicast-peers
no-software-attribute

# Interdire le relais vers des adresses internes : sans ça, quiconque a des identifiants TURN
# (le secret est dans le client Unity) peut joindre le réseau privé du serveur,
# localhost, ou les métadonnées cloud 169.254.169.254 (SSRF)
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=100::-100::ffff:ffff:ffff:ffff
denied-peer-ip=2001::-2001:1ff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2002::-2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Quotas : allocations par utilisateur (≈ 2 par pair, 16 joueurs/room) et au total
user-quota=40
total-quota=1000
# Débit max par session (octets/s) : largement assez pour du temps réel, borne l'usage en proxy
max-bps=262144

# Logs : pas de "verbose", qui écrit les noms d'utilisateur (pseudo des joueurs) à chaque requête
simple-log
